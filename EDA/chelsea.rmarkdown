# 3/21 : loading cleaned data



```{r}
#| label: read-clean-dfs
#| message: FALSE
library(tidyverse)
library(tidycensus)
library(tigris)

departments <- read_csv("~/chelseanathan0608@gmail.com - Google Drive/My Drive/Datafest/Clean-Data/departments.csv") %>%  mutate(county = str_to_title(county), department_name = str_to_title(department_name))
determinants <- read_csv("~/chelseanathan0608@gmail.com - Google Drive/My Drive/Datafest/Clean-Data/determinants.csv")
diagnosis <- read_csv("~/chelseanathan0608@gmail.com - Google Drive/My Drive/Datafest/Clean-Data/diagnosis.csv")
encounters <- read_csv("~/chelseanathan0608@gmail.com - Google Drive/My Drive/Datafest/Clean-Data/departments.csv")
patients <- read_csv("~/chelseanathan0608@gmail.com - Google Drive/My Drive/Datafest/Clean-Data/patients.csv")
providers <- read_csv("~/chelseanathan0608@gmail.com - Google Drive/My Drive/Datafest/Clean-Data/providers.csv") %>% 
  mutate(office_address = str_replace(office_address, "CT", "Ct"))
tigercensus <- read_csv("~/chelseanathan0608@gmail.com - Google Drive/My Drive/Datafest/Clean-Data/tigercensus.csv")
```

